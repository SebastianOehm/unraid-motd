<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN>

<PLUGIN 
  name="motd"
  author="Sebastian Oehm"
  version="2026.10.19.2"
  pluginURL="https://raw.githubusercontent.com/SebastianOehm/unraid-motd/main/plugin/motd.plg"
  support="https://github.com/SebastianOehm/unraid-motd/issues"
  min="6.11.5"
  icon="fa-desktop"
>

<CHANGES>
<![CDATA[
###2026.10.19.2###
## New
- Settings page under **Settings → MOTD**: edit `config.yaml` in the webGUI, preview the login output before saving, and save with YAML validation
- `motd --check-config` validates a config file, and `motd --preview --width <n>` renders the output without a terminal

## Changed
- `motd --dump-config` now also works without a terminal


For older releases, see https://github.com/SebastianOehm/unraid-motd/releases
]]>
</CHANGES>

<FILE Name="/boot/config/plugins/motd/unraid-motd-2026.10.19.2-amd64-1.txz" Run="upgradepkg --install-new">
<URL>https://github.com/SebastianOehm/unraid-motd/releases/download/2026.10.19.2/unraid-motd-2026.10.19.2-amd64-1.txz</URL>
<SHA256>6d3f77ad714d34f3999284aafee882be325a1fd7ac08d11cc21e83df8546430d</SHA256>
</FILE>

<FILE Name="/boot/config/plugins/motd/figurine_linux_amd64_v1.3.0.tar.gz">
<URL>https://github.com/arsham/figurine/releases/download/v1.3.0/figurine_linux_amd64_v1.3.0.tar.gz</URL>
<SHA256>e72430de0ca4b4b4548495d803856f5fec223f43c59a97a0bfcc714710d5032a</SHA256>
</FILE>

<!--
The 'install' script.
-->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[

tar xf /boot/config/plugins/motd/figurine_linux_amd64_v1.3.0.tar.gz -C /usr/local/bin/ --strip-components=1 deploy/figurine

# cleanup old versions
rm -f $(ls /boot/config/plugins/motd/unraid-motd-*.txz 2>/dev/null | grep -v '2026.10.19.2')
rm -f $(ls /boot/config/plugins/motd/figurine_linux_amd64_*.tar.gz 2>/dev/null | grep -v 'v1.3.0')

echo ""
echo "----------------------------------------------------"
echo " motd has been installed."
echo " Version: 2026.10.19.2"
echo "----------------------------------------------------"
echo ""
]]>
</INLINE>
</FILE>

<!--
The 'remove' script.
-->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
removepkg unraid-motd

rm -f /usr/local/bin/figurine
rm -f /usr/local/bin/motd

rm -rf /usr/local/emhttp/plugins/motd
rm -rf /boot/config/plugins/motd
]]>
</INLINE>
</FILE>

</PLUGIN>
