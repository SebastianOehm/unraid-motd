<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN>

<PLUGIN 
  name="motd"
  author="Sebastian Oehm"
  version="2026.10.19.1"
  pluginURL="https://raw.githubusercontent.com/SebastianOehm/unraid-motd/main/plugin/motd.plg"
  support="https://github.com/SebastianOehm/unraid-motd/issues"
  min="6.11.5"
  icon="fa-desktop"
>

<CHANGES>
<![CDATA[
###2026.10.19.1###
## New
- VMs module: shows the state of libvirt VMs from `virsh list --all` (opt-in, add `vms` to `global.display`)
- `vms.ignore` / `vms.ignore_stopped`: hide VMs entirely, or hide intentionally shut-off VMs from warnings


For older releases, see https://github.com/SebastianOehm/unraid-motd/releases
]]>
</CHANGES>

<FILE Name="/boot/config/plugins/motd/unraid-motd-2026.10.19.1-amd64-1.txz" Run="upgradepkg --install-new">
<URL>https://github.com/SebastianOehm/unraid-motd/releases/download/2026.10.19.1/unraid-motd-2026.10.19.1-amd64-1.txz</URL>
<SHA256>98e681ebd155cc5bfef293c941fae400578a50590d1a17d8a7cdd7c89b6dd644</SHA256>
</FILE>

<FILE Name="/boot/config/plugins/motd/figurine_linux_amd64_v1.3.0.tar.gz">
<URL>https://github.com/arsham/figurine/releases/download/v1.3.0/figurine_linux_amd64_v1.3.0.tar.gz</URL>
<SHA256>e72430de0ca4b4b4548495d803856f5fec223f43c59a97a0bfcc714710d5032a</SHA256>
</FILE>

<!--
The 'install' script.
-->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[

tar xf /boot/config/plugins/motd/figurine_linux_amd64_v1.3.0.tar.gz -C /usr/local/bin/ --strip-components=1 deploy/figurine

# cleanup old versions
rm -f $(ls /boot/config/plugins/motd/unraid-motd-*.txz 2>/dev/null | grep -v '2026.10.19.1')
rm -f $(ls /boot/config/plugins/motd/figurine_linux_amd64_*.tar.gz 2>/dev/null | grep -v 'v1.3.0')

echo ""
echo "----------------------------------------------------"
echo " motd has been installed."
echo " Version: 2026.10.19.1"
echo "----------------------------------------------------"
echo ""
]]>
</INLINE>
</FILE>

<!--
The 'remove' script.
-->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
removepkg unraid-motd

rm -f /usr/local/bin/figurine
rm -f /usr/local/bin/motd

rm -rf /usr/local/emhttp/plugins/motd
rm -rf /boot/config/plugins/motd
]]>
</INLINE>
</FILE>

</PLUGIN>
