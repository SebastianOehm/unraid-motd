<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN>

<PLUGIN 
  name="motd"
  author="Sebastian Oehm"
  version="2026.11.23"
  pluginURL="https://raw.githubusercontent.com/SebastianOehm/unraid-motd/main/plugin/motd.plg"
  support="https://github.com/SebastianOehm/unraid-motd/issues"
  min="6.11.5"
  icon="fa-desktop"
>

<CHANGES>
<![CDATA[
###2026.11.23###
## New
- Updates module: shows pending Unraid OS, plugin and Docker container updates at login (opt-in, add `updates` to `global.display`). It never goes online and only reads the results of Unraid's own update checks, plus the update check of the Compose Manager Plus plugin for compose stacks if it is installed. Any pending update makes the module a Warning. While none of the enabled parts has check results, for example right after a reboot, it shows "Not checked" (hidden with `--hide-unavailable`). `check_os`, `check_plugins` and `check_docker` turn the parts on or off, `ignore` hides single plugins, containers or `Unraid OS`. See the [configuration reference](https://github.com/SebastianOehm/unraid-motd/blob/main/CONFIGURATION.md#updates)


For older releases, see https://github.com/SebastianOehm/unraid-motd/releases
]]>
</CHANGES>

<FILE Name="/boot/config/plugins/motd/unraid-motd-2026.11.23-amd64-1.txz" Run="upgradepkg --install-new">
<URL>https://github.com/SebastianOehm/unraid-motd/releases/download/2026.11.23/unraid-motd-2026.11.23-amd64-1.txz</URL>
<SHA256>50ed45e806b1cef0860d7b2386701b24cdecdf6ae6c9edf22c2454e3df5dd928</SHA256>
</FILE>

<FILE Name="/boot/config/plugins/motd/figurine_linux_amd64_v1.3.0.tar.gz">
<URL>https://github.com/arsham/figurine/releases/download/v1.3.0/figurine_linux_amd64_v1.3.0.tar.gz</URL>
<SHA256>e72430de0ca4b4b4548495d803856f5fec223f43c59a97a0bfcc714710d5032a</SHA256>
</FILE>

<!--
The 'install' script.
-->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[

tar xf /boot/config/plugins/motd/figurine_linux_amd64_v1.3.0.tar.gz -C /usr/local/bin/ --strip-components=1 deploy/figurine

# cleanup old versions
rm -f $(ls /boot/config/plugins/motd/unraid-motd-*.txz 2>/dev/null | grep -v '2026.11.23')
rm -f $(ls /boot/config/plugins/motd/figurine_linux_amd64_*.tar.gz 2>/dev/null | grep -v 'v1.3.0')

echo ""
echo "----------------------------------------------------"
echo " motd has been installed."
echo " Version: 2026.11.23"
echo "----------------------------------------------------"
echo ""
]]>
</INLINE>
</FILE>

<!--
The 'remove' script.
-->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
removepkg unraid-motd

rm -f /usr/local/bin/figurine
rm -f /usr/local/bin/motd

rm -rf /usr/local/emhttp/plugins/motd
rm -rf /boot/config/plugins/motd
]]>
</INLINE>
</FILE>

</PLUGIN>
