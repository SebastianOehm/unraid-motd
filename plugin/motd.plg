<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN>

<PLUGIN 
  name="motd"
  author="Sebastian Oehm"
  version="2026.10.19"
  pluginURL="https://raw.githubusercontent.com/SebastianOehm/unraid-motd/main/plugin/motd.plg"
  support="https://github.com/SebastianOehm/unraid-motd/issues"
  min="6.11.5"
  icon="fa-desktop"
>

<CHANGES>
<![CDATA[
###2026.10.19###
## New maintainer
This plugin is now maintained by SebastianOehm, as a fork of dkaser/unraid-motd. Thanks to Derek Kaser for the original work.
Report issues at https://github.com/SebastianOehm/unraid-motd/issues

## New
- Compose module: shows the status of Compose Manager stacks, including fully stopped ones (opt-in, add `compose` to `display`)
- `docker.ignore_stopped` / `compose.ignore_stopped`: hide intentionally stopped containers/stacks from warnings

## Changed
- Binary is now statically linked


For older releases, see https://github.com/SebastianOehm/unraid-motd/releases
]]>
</CHANGES>

<FILE Name="/boot/config/plugins/motd/unraid-motd-2026.10.19-amd64-1.txz" Run="upgradepkg --install-new">
<URL>https://github.com/SebastianOehm/unraid-motd/releases/download/2026.10.19/unraid-motd-2026.10.19-amd64-1.txz</URL>
<SHA256>563efb82a351067e4cc55880d682b80170c5c02c047d0a6704a3b16fe94346cc</SHA256>
</FILE>

<FILE Name="/boot/config/plugins/motd/figurine_linux_amd64_v1.3.0.tar.gz">
<URL>https://github.com/arsham/figurine/releases/download/v1.3.0/figurine_linux_amd64_v1.3.0.tar.gz</URL>
<SHA256>e72430de0ca4b4b4548495d803856f5fec223f43c59a97a0bfcc714710d5032a</SHA256>
</FILE>

<!--
The 'install' script.
-->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[

tar xf /boot/config/plugins/motd/figurine_linux_amd64_v1.3.0.tar.gz -C /usr/local/bin/ --strip-components=1 deploy/figurine

# cleanup old versions
rm -f $(ls /boot/config/plugins/motd/unraid-motd-*.txz 2>/dev/null | grep -v '2026.10.19')
rm -f $(ls /boot/config/plugins/motd/figurine_linux_amd64_*.tar.gz 2>/dev/null | grep -v 'v1.3.0')

echo ""
echo "----------------------------------------------------"
echo " motd has been installed."
echo " Version: 2026.10.19"
echo "----------------------------------------------------"
echo ""
]]>
</INLINE>
</FILE>

<!--
The 'remove' script.
-->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
removepkg unraid-motd

rm -f /usr/local/bin/figurine
rm -f /usr/local/bin/motd

rm -rf /usr/local/emhttp/plugins/motd
rm -rf /boot/config/plugins/motd
]]>
</INLINE>
</FILE>

</PLUGIN>
