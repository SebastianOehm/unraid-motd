<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN>

<PLUGIN 
  name="motd"
  author="Sebastian Oehm"
  version="2026.10.24"
  pluginURL="https://raw.githubusercontent.com/SebastianOehm/unraid-motd/main/plugin/motd.plg"
  support="https://github.com/SebastianOehm/unraid-motd/issues"
  min="6.11.5"
  icon="fa-desktop"
>

<CHANGES>
<![CDATA[
###2026.10.24###
## New
- `--no-color` prints the motd without colors, including the banner. It also works without a terminal, for example from cron, a script or `ssh tower motd --no-color`, with the width from `--width` (default 80). The `NO_COLOR` environment variable ([no-color.org](https://no-color.org)) turns colors off too
- System info: RAM, swap and load are colored yellow or red when they reach `ram_warn` / `ram_crit` (default 90 / 95 %), `swap_warn` / `swap_crit` (50 / 80 %) or `load_warn` / `load_crit` (100 / 200 % of the CPU threads). `0` turns a threshold off. A swap row is shown when the system has swap

## Fixed
- System info: the uptime no longer starts with "up" or leaves an empty row below it
- System info: the Version row shows "unavailable" instead of staying empty when `/etc/unraid-version` has no version


For older releases, see https://github.com/SebastianOehm/unraid-motd/releases
]]>
</CHANGES>

<FILE Name="/boot/config/plugins/motd/unraid-motd-2026.10.24-amd64-1.txz" Run="upgradepkg --install-new">
<URL>https://github.com/SebastianOehm/unraid-motd/releases/download/2026.10.24/unraid-motd-2026.10.24-amd64-1.txz</URL>
<SHA256>a79a09827885b6674d9029c10dd0172cb1719915bd78db8aa2db11278f3f2f77</SHA256>
</FILE>

<FILE Name="/boot/config/plugins/motd/figurine_linux_amd64_v1.3.0.tar.gz">
<URL>https://github.com/arsham/figurine/releases/download/v1.3.0/figurine_linux_amd64_v1.3.0.tar.gz</URL>
<SHA256>e72430de0ca4b4b4548495d803856f5fec223f43c59a97a0bfcc714710d5032a</SHA256>
</FILE>

<!--
The 'install' script.
-->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[

tar xf /boot/config/plugins/motd/figurine_linux_amd64_v1.3.0.tar.gz -C /usr/local/bin/ --strip-components=1 deploy/figurine

# cleanup old versions
rm -f $(ls /boot/config/plugins/motd/unraid-motd-*.txz 2>/dev/null | grep -v '2026.10.24')
rm -f $(ls /boot/config/plugins/motd/figurine_linux_amd64_*.tar.gz 2>/dev/null | grep -v 'v1.3.0')

echo ""
echo "----------------------------------------------------"
echo " motd has been installed."
echo " Version: 2026.10.24"
echo "----------------------------------------------------"
echo ""
]]>
</INLINE>
</FILE>

<!--
The 'remove' script.
-->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
removepkg unraid-motd

rm -f /usr/local/bin/figurine
rm -f /usr/local/bin/motd

rm -rf /usr/local/emhttp/plugins/motd
rm -rf /boot/config/plugins/motd
]]>
</INLINE>
</FILE>

</PLUGIN>
